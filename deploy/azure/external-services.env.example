# Copy to deploy/azure/secrets/external-services.env (chmod 600).
# Never commit the filled file or paste its values into chat.
# Single quotes preserve literal $ and # in Compose env_file values.
# Keep unconfigured sections unchanged. Do not source this file in a shell.

# Octomo: set BOTH the API key and base URL when ready.
# Production endpoint: https://api.octoverse.kr
# Confirm that the receive number belongs to the intended Octomo integration.
OCTOMO_BASE_URL='http://127.0.0.1:9'
OCTOMO_API_KEY='demo-unconfigured'
OCTOMO_RECEIVE_NUMBER='16663538'

# OpenAI: API usage is billed separately from Azure student credits.
OPENAI_API_KEY=''
OPENAI_THEME_MODEL='gpt-4o-mini'
OPENAI_BASE_URL='https://api.openai.com/v1/responses'

# DeepL: blank API URL lets the app choose Free/Pro from the key suffix.
# If startup sync is enabled, the app replaces the glossary with this name.
# Azure Compose disables startup sync and scheduled backfill by default.
# Keep a dedicated demo name; never use the production glossary name.
DEEPL_API_KEY=''
DEEPL_API_URL=''
DEEPL_GLOSSARY_NAME='danzzan-azure-demo-20261014-ko-en'

# Mail: set host, port, username, password and from together when ready.
# Gmail example: smtp.gmail.com, 587, account email, app password.
MAIL_HOST='127.0.0.1'
MAIL_PORT='9'
MAIL_USERNAME=''
MAIL_PASSWORD=''
MAIL_SMTP_AUTH='true'
MAIL_SMTP_STARTTLS='true'
PASSWORD_RESET_MAIL_FROM='noreply@danzzan.invalid'

# DB_PASSWORD, JWT_SECRET and CODE_ENCRYPTION_SECRET stay in app.env.
# Do not rotate these values while configuring external services.
